msgid "Home"
msgstr "मुख्यपृष्ठ"

msgid "About"
msgstr "बद्दल"

msgid "Get Recommendation"
msgstr "शिफारस मिळवा"

msgid "History"
msgstr "इतिहास"

msgid "Medicine Recommendation System"
msgstr "औषध शिफारस प्रणाली"

msgid "All rights reserved"
msgstr "सर्व हक्क राखीव"

msgid "Disclaimer: This is an AI-based recommendation system. Always consult a qualified healthcare professional before taking any medication."
msgstr "अस्वीकरण: ही एक AI-आधारित शिफारस प्रणाली आहे. कोणतीही औषधे घेण्यापूर्वी नेहमी पात्र आरोग्य सेवा व्यावसायिकांचा सल्ला घ्या."

msgid "AI-powered medicine recommendations based on your symptoms"
msgstr "तुमच्या लक्षणांवर आधारित AI-संचालित औषध शिफारसी"

msgid "Get Started"
msgstr "सुरू करा"

msgid "AI-Powered"
msgstr "AI-संचालित"

msgid "Advanced machine learning for accurate recommendations"
msgstr "अचूक शिफारसींसाठी प्रगत मशीन लर्निंग"

msgid "Instant Results"
msgstr "त्वरित परिणाम"

msgid "Get recommendations in seconds with detailed information"
msgstr "तपशीलवार माहितीसह सेकंदात शिफारसी मिळवा"

msgid "Safe & Reliable"
msgstr "सुरक्षित आणि विश्वासार्ह"

msgid "Comprehensive safety and usage information included"
msgstr "सर्वसमावेशक सुरक्षा आणि वापर माहिती समाविष्ट"

msgid "Symptoms"
msgstr "लक्षणे"

msgid "Age"
msgstr "वय"

msgid "Gender"
msgstr "लिंग"

msgid "Medical History"
msgstr "वैद्यकीय इतिहास"

msgid "Male"
msgstr "पुरुष"

msgid "Female"
msgstr "स्त्री"

msgid "Other"
msgstr "इतर"

msgid "Results"
msgstr "परिणाम"

msgid "Recommended Medicines"
msgstr "शिफारस केलेली औषधे"

msgid "Usage Instructions"
msgstr "वापर सूचना"

msgid "Side Effects"
msgstr "दुष्परिणाम"

msgid "Precautions"
msgstr "सावधगिरी"

msgid "Patient Information"
msgstr "रुग्ण माहिती"

msgid "Date"
msgstr "तारीख"

msgid "New Recommendation"
msgstr "नवीन शिफारस"

msgid "Back to Home"
msgstr "मुख्यपृष्ठावर परत या"

msgid "Important Disclaimer"
msgstr "महत्त्वाचे अस्वीकरण"

msgid "No Recommendations Found"
msgstr "कोणत्याही शिफारसी सापडल्या नाहीत"

msgid "Get Medicine Recommendation"
msgstr "औषध शिफारस मिळवा"

msgid "Note"
msgstr "लक्षात घ्या"

msgid "Please provide accurate information for better recommendations. This system is for informational purposes only and does not replace professional medical advice."
msgstr "कृपया चांगल्या शिफारसींसाठी अचूक माहिती द्या. ही प्रणाली केवळ माहितीच्या उद्देशाने आहे आणि व्यावसायिक वैद्यकीय सल्ल्याची जागा घेत नाही."

msgid "Example: fever, headache, cough, sore throat"
msgstr "उदाहरण: ताप, डोकेदुखी, खोकला, घसा दुखणे"

msgid "Include any allergies, chronic conditions, or current medications"
msgstr "कोणत्याही ऍलर्जी, जुनाट आजार किंवा सध्याची औषधे समाविष्ट करा"

msgid "Get Recommendations"
msgstr "शिफारसी मिळवा"

msgid "Important"
msgstr "महत्त्वाचे"

msgid "These recommendations are AI-generated and should not replace professional medical consultation."
msgstr "या शिफारसी AI-निर्मित आहेत आणि व्यावसायिक वैद्यकीय सल्ल्याची जागा घेऊ नयेत."

msgid "Privacy"
msgstr "गोपनीयता"

msgid "Your information is used only for generating recommendations and is stored securely."
msgstr "तुमची माहिती केवळ शिफारसी तयार करण्यासाठी वापरली जाते आणि सुरक्षितपणे संग्रहित केली जाते."

msgid "years"
msgstr "वर्षे"

msgid "Match"
msgstr "जुळवा"

msgid "These recommendations are generated by an AI system based on the symptoms you provided."
msgstr "या शिफारसी तुम्ही दिलेल्या लक्षणांवर आधारित AI प्रणालीद्वारे तयार केल्या आहेत."

msgid "Always consult a qualified healthcare professional or doctor before taking any medication."
msgstr "कोणतीही औषधे घेण्यापूर्वी नेहमी पात्र आरोग्य सेवा व्यावसायिक किंवा डॉक्टरांचा सल्ला घ्या."

msgid "This system is for informational purposes only and does not constitute medical advice, diagnosis, or treatment."
msgstr "ही प्रणाली केवळ माहितीच्या उद्देशाने आहे आणि वैद्यकीय सल्ला, निदान किंवा उपचार करत नाही."

msgid "We couldn't find matching medicines for your symptoms. Please try with different symptoms or consult a doctor."
msgstr "आम्हाला तुमच्या लक्षणांसाठी योग्य औषधे सापडली नाहीत. कृपया वेगळ्या लक्षणांसह प्रयत्न करा किंवा डॉक्टरांचा सल्ला घ्या."

msgid "Register"
msgstr "नोंदणी करा"

msgid "Login"
msgstr "लॉगिन"

msgid "Logout"
msgstr "लॉगआउट"

msgid "Create Account"
msgstr "खाते तयार करा"

msgid "Username"
msgstr "वापरकर्तानाव"

msgid "Password"
msgstr "संकेतशब्द"

msgid "Confirm Password"
msgstr "संकेतशब्दाची पुष्टी करा"

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "आवश्यक. 150 अक्षरे किंवा कमी. फक्त अक्षरे, अंक आणि @/./+/-/_ परवानगी आहे."

msgid "Your password must contain at least 8 characters."
msgstr "तुमच्या संकेतशब्दात किमान 8 अक्षरे असणे आवश्यक आहे."

msgid "Enter the same password as before, for verification."
msgstr "सत्यापनासाठी पूर्वीसारखाच संकेतशब्द प्रविष्ट करा."

msgid "Already have an account?"
msgstr "आधीपासूनच खाते आहे?"

msgid "Login here"
msgstr "येथे लॉगिन करा"

msgid "Don't have an account?"
msgstr "खाते नाही?"

msgid "Register here"
msgstr "येथे नोंदणी करा"

msgid "Enter your symptoms (e.g., fever, headache, cough)"
msgstr "तुमची लक्षणे प्रविष्ट करा (उदा: ताप, डोकेदुखी, खोकला)"

msgid "Enter your age"
msgstr "तुमचे वय प्रविष्ट करा"

msgid "Any existing medical conditions or allergies (optional)"
msgstr "कोणत्याही विद्यमान वैद्यकीय स्थिती किंवा ऍलर्जी (पर्यायी)"
