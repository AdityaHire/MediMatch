msgid "Home"
msgstr "होम"

msgid "Get Recommendation"
msgstr "सिफारिश प्राप्त करें"

msgid "History"
msgstr "इतिहास"

msgid "Medicine Recommendation System"
msgstr "दवा सिफारिश प्रणाली"

msgid "All rights reserved"
msgstr "सर्वाधिकार सुरक्षित"

msgid "Disclaimer: This is an AI-based recommendation system. Always consult a qualified healthcare professional before taking any medication."
msgstr "अस्वीकरण: यह एक एआई-आधारित सिफारिश प्रणाली है। किसी भी दवा लेने से पहले हमेशा एक योग्य स्वास्थ्य पेशेवर से परामर्श लें।"

msgid "AI-powered medicine recommendations based on your symptoms"
msgstr "आपके लक्षणों के आधार पर एआई-संचालित दवा सिफारिशें"

msgid "Get Started"
msgstr "शुरू करें"

msgid "AI-Powered"
msgstr "एआई-संचालित"

msgid "Advanced machine learning for accurate recommendations"
msgstr "सटीक सिफारिशों के लिए उन्नत मशीन लर्निंग"

msgid "Instant Results"
msgstr "त्वरित परिणाम"

msgid "Get recommendations in seconds with detailed information"
msgstr "विस्तृत जानकारी के साथ सेकंड में सिफारिशें प्राप्त करें"

msgid "Safe & Reliable"
msgstr "सुरक्षित और विश्वसनीय"

msgid "Comprehensive safety and usage information included"
msgstr "व्यापक सुरक्षा और उपयोग की जानकारी शामिल है"

msgid "Symptoms"
msgstr "लक्षण"

msgid "Age"
msgstr "आयु"

msgid "Gender"
msgstr "लिंग"

msgid "Medical History"
msgstr "चिकित्सा इतिहास"

msgid "Male"
msgstr "पुरुष"

msgid "Female"
msgstr "महिला"

msgid "Other"
msgstr "अन्य"

msgid "Results"
msgstr "परिणाम"

msgid "Recommended Medicines"
msgstr "अनुशंसित दवाएं"

msgid "Usage Instructions"
msgstr "उपयोग निर्देश"

msgid "Side Effects"
msgstr "दुष्प्रभाव"

msgid "Precautions"
msgstr "सावधानियां"

msgid "Patient Information"
msgstr "रोगी की जानकारी"

msgid "Date"
msgstr "तारीख"

msgid "New Recommendation"
msgstr "नई सिफारिश"

msgid "Back to Home"
msgstr "होम पर वापस जाएं"

msgid "Important Disclaimer"
msgstr "महत्वपूर्ण अस्वीकरण"

msgid "No Recommendations Found"
msgstr "कोई सिफारिश नहीं मिली"

msgid "Get Medicine Recommendation"
msgstr "दवा की सिफारिश प्राप्त करें"

msgid "Note"
msgstr "ध्यान दें"

msgid "Please provide accurate information for better recommendations. This system is for informational purposes only and does not replace professional medical advice."
msgstr "बेहतर सिफारिशों के लिए कृपया सटीक जानकारी प्रदान करें। यह प्रणाली केवल सूचनात्मक उद्देश्यों के लिए है और पेशेवर चिकित्सा सलाह का स्थान नहीं लेती है।"

msgid "Example: fever, headache, cough, sore throat"
msgstr "उदाहरण: बुखार, सिरदर्द, खांसी, गले में खराश"

msgid "Include any allergies, chronic conditions, or current medications"
msgstr "किसी भी एलर्जी, दीर्घकालिक स्थिति, या वर्तमान दवाओं को शामिल करें"

msgid "Get Recommendations"
msgstr "सिफारिशें प्राप्त करें"

msgid "Important"
msgstr "महत्वपूर्ण"

msgid "These recommendations are AI-generated and should not replace professional medical consultation."
msgstr "ये सिफारिशें AI द्वारा उत्पन्न की गई हैं और पेशेवर चिकित्सा परामर्श का स्थान नहीं ले सकती हैं।"

msgid "Privacy"
msgstr "गोपनीयता"

msgid "Your information is used only for generating recommendations and is stored securely."
msgstr "आपकी जानकारी केवल सिफारिशें उत्पन्न करने के लिए उपयोग की जाती है और सुरक्षित रूप से संग्रहीत की जाती है।"

msgid "years"
msgstr "वर्ष"

msgid "Match"
msgstr "मिलान"

msgid "These recommendations are generated by an AI system based on the symptoms you provided."
msgstr "ये सिफारिशें आपके द्वारा प्रदान किए गए लक्षणों के आधार पर एआई सिस्टम द्वारा उत्पन्न की गई हैं।"

msgid "Always consult a qualified healthcare professional or doctor before taking any medication."
msgstr "किसी भी दवा लेने से पहले हमेशा एक योग्य स्वास्थ्य पेशेवर या डॉक्टर से परामर्श लें।"

msgid "This system is for informational purposes only and does not constitute medical advice, diagnosis, or treatment."
msgstr "यह प्रणाली केवल सूचनात्मक उद्देश्यों के लिए है और चिकित्सा सलाह, निदान या उपचार का गठन नहीं करती है।"

msgid "We couldn't find matching medicines for your symptoms. Please try with different symptoms or consult a doctor."
msgstr "हम आपके लक्षणों के लिए उपयुक्त दवाएं नहीं ढूंढ सके। कृपया विभिन्न लक्षणों के साथ प्रयास करें या डॉक्टर से परामर्श लें।"

msgid "Register"
msgstr "पंजीकरण करें"

msgid "Login"
msgstr "लॉगिन"

msgid "Logout"
msgstr "लॉगआउट"

msgid "Create Account"
msgstr "खाता बनाएं"

msgid "Username"
msgstr "उपयोगकर्ता नाम"

msgid "Password"
msgstr "पासवर्ड"

msgid "Confirm Password"
msgstr "पासवर्ड की पुष्टि करें"

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "आवश्यक। 150 अक्षर या कम। केवल अक्षर, अंक और @/./+/-/_ की अनुमति है।"

msgid "Your password must contain at least 8 characters."
msgstr "आपके पासवर्ड में कम से कम 8 अक्षर होने चाहिए।"

msgid "Enter the same password as before, for verification."
msgstr "सत्यापन के लिए पहले जैसा ही पासवर्ड दर्ज करें।"

msgid "Already have an account?"
msgstr "पहले से खाता है?"

msgid "Login here"
msgstr "यहां लॉगिन करें"

msgid "Don't have an account?"
msgstr "खाता नहीं है?"

msgid "Register here"
msgstr "यहां पंजीकरण करें"

msgid "Enter your symptoms (e.g., fever, headache, cough)"
msgstr "अपने लक्षण दर्ज करें (जैसे: बुखार, सिरदर्द, खांसी)"

msgid "Enter your age"
msgstr "अपनी उम्र दर्ज करें"

msgid "Any existing medical conditions or allergies (optional)"
msgstr "कोई मौजूदा चिकित्सा स्थिति या एलर्जी (वैकल्पिक)"
